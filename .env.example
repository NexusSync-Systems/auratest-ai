# AuraGuard — šablona konfigurace
#
#   cp .env.example .env
#
# Bez hodnoty = použije se výchozí uvedená v komentáři. Prázdná hodnota
# NĚKDE ale něco znamená (viz ALLOWED_LLM_HOSTS), takže si komentářů všímej.
#
# Do gitu tenhle soubor patří, `.env` ne.

# ─────────────────────────────────────────────────────────────────────────────
# Základ  — POVINNÉ v produkci
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001

# Za reverzní proxy MUSÍ být 1, jinak je req.ip vždy adresa proxy a rate
# limiting se klíčuje na jedinou hodnotu — tedy neplatí.
# Hodnota se předává Expressu jako `trust proxy`: 1 = jedna proxy před námi.
TRUST_PROXY=1

# Odkud smí chodit prohlížeč. Bez tohohle CORS propustí cokoli.
# Čárkou oddělený seznam, včetně schématu, bez koncového lomítka.
ALLOWED_ORIGINS=https://auraguard.example.com

# Základ pro odkazy na artefakty (screenshoty, videa) v reportech a Slacku.
# Bez něj se odkazy generují relativně a mimo aplikaci nefungují.
PUBLIC_BASE_URL=https://auraguard.example.com

# Kdo smí nástroj používat.
#
# Registrace ve Firebase je otevřená — kdokoli, kdo najde adresu, si účet
# vyrobí sám. Skenování za přihlášením je tím pádem brána bez zámku, protože
# klíč si u ní každý udělá.
#
# Kontrola je na SERVERU, v ověřovacím middleware. Schovat tlačítko ve
# frontendu nestačí: endpointy jdou volat přímo.
#
# PRÁZDNÉ = BEZ OMEZENÍ. Server na to při startu upozorní; tiché neomezení
# by bylo horší než hlučné. Výchozí otevřenost je zvolená proto, aby upgrade
# existující instalace nezamkl všechny uživatele naráz — včetně toho, kdo
# upgrade dělá.
#
# Oba seznamy fungují jako sjednocení. Domény se píšou bez zavináče.
# ALLOWED_EMAILS=jan@firma.cz,eva@firma.cz
# ALLOWED_EMAIL_DOMAINS=firma.cz

# ─────────────────────────────────────────────────────────────────────────────
# Jazykový model (LLM)
# ─────────────────────────────────────────────────────────────────────────────
#
# Kde běží Ollama. Výchozí: http://localhost:11434
# LLM_HOST=http://localhost:11434

# Allowlist hostů, které smí klient zvolit. Host z těla requestu se jinak
# ignoruje — jinak by šlo poslat POST na libovolnou interní službu.
#
# PRÁZDNÁ HODNOTA = LLM JE VYPNUTÉ. Server pak režimy závislé na modelu
# odmítne srozumitelnou hláškou (HTTP 503) místo toho, aby spadl na odmítnuté
# spojení, a UI je vůbec nenabídne. Compliance skenery (NIS2/PQC, CRA, AI Act,
# GDPR, EAA, DORA) na LLM nezávisí a fungují v plném rozsahu.
#
# Nezadáno (řádek smazaný) = použije se LLM_HOST, tedy LLM zapnuté.
ALLOWED_LLM_HOSTS=

# Timeout dotazu na model v ms. Výchozí: 120000
# LLM_TIMEOUT_MS=120000

# ─────────────────────────────────────────────────────────────────────────────
# Firebase
# ─────────────────────────────────────────────────────────────────────────────
#
# Servisní klíč pro firebase-admin (Auth + Firestore) se NEZADÁVÁ sem — je to
# soubor `firebase-credentials.json` v kořeni projektu. docker-compose ho
# montuje read-only a do image se nekopíruje.
#
# Následující proměnné jdou do frontendu PŘI BUILDU (Vite je zapéká do bundlu).
# Nejsou tajné — web config Firebase je veřejný z principu a chrání ho
# Firestore rules. Když je nevyplníš, použijí se fallback hodnoty ze
# frontend/src/lib/firebase.js.
#
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Zátěž a limity
# ─────────────────────────────────────────────────────────────────────────────
#
# Kolik prohlížečů může běžet naráz. Jeden běh Playwrightu si vezme ~1–2 GB,
# takže na 12GB stroji dává smysl 2. Výchozí: 2
# MAX_CONCURRENT_BROWSERS=2

# Po jak dlouhé době se zaseknutý slot pro prohlížeč uvolní násilím (ms).
# Výchozí: 300000 (5 min)
# BROWSER_SLOT_MAX_HOLD_MS=300000

# Strop kroků agenta v jednom běhu. Výchozí: 50
# MAX_AGENT_STEPS=50

# Timeout jednoho TLS handshaku v sondě (ms). Výchozí: 8000
# Zvyš, pokud skenuješ pomalé servery a dostáváš „netestováno".
# TLS_PROBE_TIMEOUT_MS=8000

# Kolik obrázků se vzorkuje při hledání C2PA manifestů (AI Act čl. 50 odst. 2).
# Výchozí: 10
# MAX_C2PA_SAMPLES=10

# Audit překladů: kolik textů a kolik souběžných dotazů. Výchozí: 200 / 3
# TRANSLATION_AUDIT_MAX_TEXTS=200
# TRANSLATION_AUDIT_CONCURRENCY=3

# Strop LRU cache událostí v paměti. Výchozí: 1000
# EVENT_CACHE_MAX_ENTRIES=1000

# Argumenty navíc pro Chromium, čárkou oddělené.
# Na Cloud Run je potřeba --disable-dev-shm-usage, protože /dev/shm je malý.
# BROWSER_ARGS=

# Kořen pro artefakty (screenshots/, videos/, generated-scripts/).
# Výchozí: adresář projektu. Měň jen když montuješ jiný disk.
# AURAGUARD_ROOT=/app

# ─────────────────────────────────────────────────────────────────────────────
# Databáze skenovaných aplikací (volitelné)
# ─────────────────────────────────────────────────────────────────────────────
#
# Allowlist databázových hostů, na které se smí nástroj připojit.
# Prázdné nebo nezadané = funkce vypnutá.
# ALLOWED_DB_HOSTS=

# ─────────────────────────────────────────────────────────────────────────────
# Slack (volitelné)
# ─────────────────────────────────────────────────────────────────────────────
#
# Tři samostatní boti — každý pro jiný druh hlášení. Bez tokenu se dané
# hlášení tiše přeskočí.
# SLACK_COMPLIANCE_BOT_TOKEN=xoxb-...
# SLACK_COMPLIANCE_SIGNING_SECRET=
# SLACK_UPTIME_BOT_TOKEN=xoxb-...
# SLACK_UPTIME_SIGNING_SECRET=
# SLACK_AI_BOT_TOKEN=xoxb-...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL=#compliance

# Sdílené tajemství pro spuštění testu z venku (webhook, CI).
# Nechat prázdné = endpoint je vypnutý.
# TRIGGER_TEST_SECRET=
