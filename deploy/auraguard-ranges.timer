[Unit]
Description=Týdenní obnova snímku IP rozsahů AuraGuard

[Timer]
# V neděli ve 4:15. Poskytovatelé vydávají průběžně (Azure týdenní
# soubory ServiceTags_Public_RRRRMMDD.json, AWS mění createDate řádově
# denně), takže týdenní perioda drží snímek hluboko pod prahem 90 dnů,
# po jehož překročení z něj `cloud-ranges.js` přestane určovat zemi.
OnCalendar=Sun *-*-* 04:15:00
RandomizedDelaySec=30m

# Když byl stroj vypnutý, dožene se to po startu. Bez toho by se
# u instance, která běží jen občas, neobnovilo nikdy — a snímek by
# tiše stárnul.
Persistent=true

[Install]
WantedBy=timers.target
