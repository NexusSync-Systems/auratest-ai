[Unit]
Description=AuraGuard — obnova snímku IP rozsahů poskytovatelů cloudu
Documentation=file:///home/nexus/auratest-ai/scripts/update-cloud-ranges.mjs
# Skript stahuje data od AWS, GCP a Azure.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=nexus
WorkingDirectory=/home/nexus/auratest-ai

# Node je jen v kontejneru, na hostiteli není. Skript proto běží uvnitř,
# ale zapisuje do `data/`, což je bind svazek z hostitele — nový snímek
# tedy zůstane i po zahození kontejneru. Běžící aplikace ho vidí bez
# restartu proto, že `loadRanges` drží cache podle času změny souboru;
# samotný svazek by na to nestačil (do opravy z 19. 9. 2026 se snímek
# načetl jednou a držel se do restartu procesu).
#
# `run --rm` místo `exec`: `exec` vyžaduje běžící kontejner a při
# restartu aplikace by úloha selhala.
#
# Skript sám odmítne přepsat snímek, když se nepodařilo stáhnout
# všechny tři zdroje nebo když je nový výrazně menší než stávající —
# starý a úplný je lepší než nový a děravý.
ExecStart=/usr/bin/docker compose run --rm --entrypoint node auratest-ai scripts/update-cloud-ranges.mjs

# Stahování tří zdrojů; Azure soubor má přes 20 MB.
TimeoutStartSec=15m

NoNewPrivileges=true
