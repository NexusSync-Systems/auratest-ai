[Unit]
Description=AuraGuard — úklid artefaktů (screenshoty, videa, skripty)
Documentation=file:///home/ubuntu/auratest-ai/deploy/cleanup-artifacts.sh
# Nemá smysl uklízet, když aplikace neběží a nic nepřibývá.
After=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/auratest-ai
Environment=RETENTION_DAYS=7
ExecStart=/usr/bin/env bash deploy/cleanup-artifacts.sh

# Úloha maže soubory — omezit ji jen na to, co skutečně potřebuje.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/ubuntu/auratest-ai
NoNewPrivileges=true
