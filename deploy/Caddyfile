# Reverzní proxy pro AuraGuard.
#
# Caddy vyřídí certifikát od Let's Encrypt sám. Podmínka: doména musí mít
# A záznam na veřejnou IP instance UŽ PŘED prvním startem, jinak ACME výzva
# neprojde a Caddy skončí chybou.
#
# Nasazení:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo sed -i 's/auraguard.example.com/tvoje.domena.cz/' /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Ověření konfigurace bez restartu:
#   caddy validate --config /etc/caddy/Caddyfile

auraguard.example.com {
	# Aplikace poslouchá jen na loopbacku (viz docker-compose.yml), takže
	# tudy vede jediná cesta zvenčí.
	reverse_proxy 127.0.0.1:3001 {
		# Audity běží dlouho: chaos test dělá baseline i chaos běh, každý
		# s 30s timeoutem a 5s pozorováním. Výchozích 30 s by ho useklo
		# uprostřed a uživatel by dostal 504 místo výsledku.
		transport http {
			read_timeout 180s
			write_timeout 180s
		}

		# WebSocket (živé logy agenta) Caddy proxuje sám, bez extra
		# konfigurace — hlavičky Upgrade/Connection předává automaticky.

		# Aplikace čte req.ip kvůli rate limitingu a má TRUST_PROXY=1.
		# Caddy posílá X-Forwarded-For i X-Forwarded-Proto ve výchozím
		# stavu; kdyby je přeposlal klient, Caddy je přepíše, ne přidá.
	}

	# ── Bezpečnostní hlavičky ────────────────────────────────────────────
	#
	# Server je sám nenastavuje. U nástroje, který cizím webům vytýká
	# chybějící HSTS a CSP, je to přinejmenším nepříjemné — a hlavně jsou
	# to hlavičky, které tady dávají smysl: aplikace za přihlášením, která
	# zobrazuje obsah cizích webů.
	header {
		# Rok, včetně subdomén. Preload záměrně NE — je to prakticky
		# nevratné a na pilotní instalaci se to nehodí.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		X-Content-Type-Options "nosniff"

		# frame-ancestors 'none' je moderní ekvivalent X-Frame-Options: DENY.
		# Obojí schválně — starší prohlížeče CSP frame-ancestors neznají.
		X-Frame-Options "DENY"

		Referrer-Policy "strict-origin-when-cross-origin"

		# Aplikace nepotřebuje kameru, mikrofon ani geolokaci.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

		# CSP:
		# - 'unsafe-inline' u stylů je nutné, Vite injektuje inline styly
		# - connect-src 'self' pokrývá i wss:// na stejném původu
		# - img-src data: kvůli náhledům screenshotů
		# - frame-ancestors 'none' brání vložení do cizího rámu
		# Content-Security-Policy
		#
		# `connect-src 'self'` tu původně bylo bez výjimek — a zamklo
		# přihlášení. Firebase Auth mluví z prohlížeče přímo na Google API,
		# takže se login neprojevil chybou hesla, ale hláškou
		# `auth/network-request-failed`, která svádí hledat výpadek sítě.
		#
		# Vyjmenované jsou jen adresy, které aplikace skutečně potřebuje:
		#   identitytoolkit  přihlášení a registrace
		#   securetoken      obnova ID tokenu
		#   firestore        projekty, session, monitory
		# WebSocket na vlastní původ pokrývá `'self'`.
		#
		# Písma z fonts.googleapis.com jsou požadavek na třetí stranu —
		# přesně ten typ, který GDPR skener tohohle nástroje u cizích webů
		# hlásí. Vlastní hosting písem to odstraní; do té doby je to tady
		# poznamenané, ne zamlčené.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

		# Neprozrazovat, co pod tím běží.
		-Server
		-X-Powered-By
	}

	# ── Komprese ─────────────────────────────────────────────────────────
	encode zstd gzip

	# ── Logy ─────────────────────────────────────────────────────────────
	#
	# Bez rotace zaplní 50GB disk instance. Caddy rotuje sám, ale výchozí
	# hodnoty jsou štědré.
	log {
		output file /var/log/caddy/auraguard.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		# Query string se z logu VYŘAZUJE.
		#
		# Chodí v něm adresy skenovaných webů — tedy údaj o tom, koho zákazník
		# auditoval — a dřív i capability tokeny k artefaktům. Log s retencí
		# 720 hodin je špatné místo pro obojí: kdo se k němu dostane, přečte
		# si historii zákazníkových auditů.
		#
		# Tokeny už v URL nejsou (artefakty se načítají ověřeným požadavkem),
		# ale adresy zůstávají. Filtr je proto na místě tak jako tak.
		#
		# `format filter` s `wrap json` nahrazuje samotné `format json` —
		# obojí vedle sebe by bylo přinejmenším matoucí.
		# Maže se CELÝ query string, ne vyjmenované parametry.
		#
		# Původní podoba mazala `t`, `url`, `from` a `to` — tedy ty, které mě
		# napadly. Jenže filtr, který chrání jen známé případy, je u nástroje
		# tohohle druhu slabý: první parametr, na který někdo v budoucnu
		# zapomene, začne tiše téct do logu s retencí 720 hodin.
		#
		# Cesta v logu zůstává, takže je pořád vidět, který endpoint se volal
		# a s jakým výsledkem. Pro provoz to stačí; obsah parametrů k ničemu
		# nepotřebujeme.
		# Pole se adresuje CELOU cestou v JSON struktuře: `request>uri`.
		# Samotné `uri` filtr netrefil — v logu je vnořené pod `request`,
		# takže se tiše neaplikoval a query string tekl dál.
		format filter {
			wrap json
			fields {
				request>uri regexp "[?].*" ""
			}
		}
	}
}
