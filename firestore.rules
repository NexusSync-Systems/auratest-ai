rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// AuraTest — Firestore bezpečnostní pravidla
//
// Pozn.: Backend (server.js / db.js) přistupuje přes Firebase Admin SDK, který
// tato pravidla OBCHÁZÍ. Pravidla proto slouží jako obrana do hloubky pro
// případný přímý přístup z klienta — omezují data na vlastníka (userId).
// Primární kontrola přístupu je v API (authenticateToken + filtrace dle userId).
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Projekty, monitory a session — VÝHRADNĚ přes API, přímý přístup zakázán.
    //
    // Dřívější podoba pravidel dovolovala přihlášenému klientovi zapsat
    // dokument s vlastním `userId`. To znělo jako obrana do hloubky, ale ve
    // skutečnosti to byla druhá cesta k týmž datům, která obcházela obě
    // kontroly v API:
    //
    //   1. Allowlist e-mailů. Registrace ve Firebase je otevřená (apiKey je
    //      veřejný), takže účet si založí kdokoli. Server ho k API nepustí,
    //      ale do Firestore psal přímo.
    //   2. Ověření cíle proti SSRF. Monitor zapsaný mimo `POST /api/monitors`
    //      neprošel `assertPublicHttpUrl`, a plánovač ho pak spustil sám.
    //      Útočník tak donutil server otevřít vnitřní adresu a screenshot si
    //      vyzvedl přes artifactToken, který si do téhož dokumentu napsal.
    //
    // Frontend k těmto kolekcím nesahá — čte je přes /api/*. Zavření tedy nic
    // nerozbíjí a odstraňuje celou třídu útoků najednou.
    match /projects/{id} {
      allow read, write: if false;
    }
    match /monitors/{id} {
      allow read, write: if false;
    }
    match /sessions/{id} {
      allow read, write: if false;
    }

    // Uživatelský profil a historie — vlastněné přes ID dokumentu (uid).
    // Zapisuje přímo klient (App.jsx: handleSaveProfile), proto musí být povoleno.
    // Omezení tvaru: bez něj je profil volné úložiště v produkčním Firestore
    // pro kohokoli, kdo si založí účet (byť mimo allowlist).
    function profileShapeOk() {
      return request.resource.data.keys().hasOnly([
        'name', 'defaultUrl', 'slackWebhook', 'updatedAt'
      ]);
    }

    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update:
        if request.auth != null && request.auth.uid == uid && profileShapeOk();

      match /history/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Telemetrie (auraguard_events) — zapisuje/čte výhradně server přes Admin SDK.
    // Přímý klientský přístup zakázán.
    match /auraguard_events/{id} {
      allow read, write: if false;
    }

    // Default deny — vše ostatní zakázáno.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
