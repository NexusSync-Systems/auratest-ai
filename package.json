{
  "name": "auratest-ai",
  "version": "1.0.0",
  "description": "Local AI QA Agent",
  "main": "server.js",
  "type": "module",
  "bin": {
    "auraguard": "./bin/auraguard-cli.js"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev:server": "node --watch server.js",
    "build": "cd frontend && npm run build",
    "frontend:install": "cd frontend && npm install",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:test": "cd frontend && npm test",
    "install:all": "npm install && npm run frontend:install",
    "setup": "npm run install:all && npx playwright install",
    "dev": "npx concurrently \"npm run dev:server\" \"npm run frontend:dev\"",
    "test": "jest",
    "check:runtime": "node scripts/check-runtime.mjs",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/smoke-test.mjs",
    "eval:llm": "node tools/llm-eval/run-eval.js --cases adapters/auauratesting-gemma/eval-cases.jsonl --system-file adapters/auauratesting-gemma/system-prompt.txt --run-model --strict",
    "eval:llm:capture": "node tools/llm-eval/run-eval.js --cases adapters/auauratesting-gemma/eval-cases.jsonl --system-file adapters/auauratesting-gemma/system-prompt.txt --run-model --model auauratesting-gemma --tag quality --timeout-ms 30000 --verbose --write-failures adapters/auauratesting-gemma/model-failures.jsonl",
    "eval:llm:offline": "node tools/llm-eval/run-eval.js --cases adapters/auauratesting-gemma/eval-cases.jsonl --strict",
    "dataset:sft": "node tools/llm-eval/export-sft.js --cases adapters/auauratesting-gemma/eval-cases.jsonl --output adapters/auauratesting-gemma/data/auratest-gemma-sft.jsonl",
    "dataset:preferences": "node tools/llm-eval/export-preferences.js --cases adapters/auauratesting-gemma/eval-cases.jsonl --failures adapters/auauratesting-gemma/model-failures.jsonl --output adapters/auauratesting-gemma/data/auratest-gemma-preferences.jsonl",
    "dataset:preferences:v3": "node tools/llm-eval/export-preferences.js --cases adapters/auauratesting-gemma/eval-cases.jsonl --failures adapters/auauratesting-gemma/model-failures-v3.jsonl --output adapters/auauratesting-gemma/data/auratest-gemma-preferences-v3.jsonl",
    "dataset:failures:v3": "node tools/llm-eval/run-eval.js --cases adapters/auauratesting-gemma/eval-cases.jsonl --responses adapters/auauratesting-gemma/finetune/mlx-responses-v3.jsonl --verbose --write-failures adapters/auauratesting-gemma/model-failures-v3.jsonl --model-label mlx-lowram-lora-v3",
    "dataset:sft:v3-repair": "node tools/llm-eval/export-repair-sft.js --cases adapters/auauratesting-gemma/eval-cases.jsonl --failures adapters/auauratesting-gemma/model-failures-v3.jsonl --output adapters/auauratesting-gemma/data/auratest-gemma-sft-v3-repair.jsonl --repeat 2 --include-all",
    "finetune:mlx:prepare:v3-repair": "node tools/llm-eval/export-mlx-sft.js --input adapters/auauratesting-gemma/data/auratest-gemma-sft-v3-repair.jsonl --output-dir adapters/auauratesting-gemma/finetune/mlx-data-v3-repair --train-ratio 0.85 --valid-ratio 0.1",
    "finetune:mlx:train:v4-repair": "DATA_DIR=adapters/auauratesting-gemma/finetune/mlx-data-v3-repair OUTPUT_DIR=adapters/auauratesting-gemma/finetune/output/lowram-lora-v4 RESUME_ADAPTER_FILE=adapters/auauratesting-gemma/finetune/output/lowram-lora-v3/adapters.safetensors ITERS=30 LEARNING_RATE=2e-6 LORA_LAYERS=8 bash adapters/auauratesting-gemma/finetune/train-lowram.sh",
    "finetune:mlx:train:v4-safe": "DATA_DIR=adapters/auauratesting-gemma/finetune/mlx-data-v3-repair OUTPUT_DIR=adapters/auauratesting-gemma/finetune/output/lowram-lora-v4-safe RESUME_ADAPTER_FILE=adapters/auauratesting-gemma/finetune/output/lowram-lora-v3/adapters.safetensors ITERS=15 LEARNING_RATE=1e-6 LORA_LAYERS=4 SAVE_EVERY=5 STEPS_PER_EVAL=15 VAL_BATCHES=4 MAX_SEQ_LENGTH=1536 bash adapters/auauratesting-gemma/finetune/train-lowram.sh",
    "eval:mlx:generate:v4": "adapters/auauratesting-gemma/finetune/.venv/bin/python tools/llm-eval/run-mlx-eval.py --cases adapters/auauratesting-gemma/eval-cases.jsonl --system-file adapters/auauratesting-gemma/system-prompt.txt --adapter-path adapters/auauratesting-gemma/finetune/output/lowram-lora-v4 --output adapters/auauratesting-gemma/finetune/mlx-responses-v4.jsonl",
    "eval:mlx:score:v4": "node tools/llm-eval/run-eval.js --cases adapters/auauratesting-gemma/eval-cases.jsonl --responses adapters/auauratesting-gemma/finetune/mlx-responses-v4.jsonl",
    "eval:mlx:generate:v4-safe": "adapters/auauratesting-gemma/finetune/.venv/bin/python tools/llm-eval/run-mlx-eval.py --cases adapters/auauratesting-gemma/eval-cases.jsonl --system-file adapters/auauratesting-gemma/system-prompt.txt --adapter-path adapters/auauratesting-gemma/finetune/output/lowram-lora-v4-safe --output adapters/auauratesting-gemma/finetune/mlx-responses-v4-safe.jsonl",
    "eval:mlx:score:v4-safe": "node tools/llm-eval/run-eval.js --cases adapters/auauratesting-gemma/eval-cases.jsonl --responses adapters/auauratesting-gemma/finetune/mlx-responses-v4-safe.jsonl",
    "dataset:failures:normalize": "node tools/llm-eval/normalize-failures.js --input adapters/auauratesting-gemma/model-failures.jsonl",
    "dataset:failures:report": "node tools/llm-eval/report-failures.js --failures adapters/auauratesting-gemma/model-failures.jsonl --output adapters/auauratesting-gemma/data/failure-report.md",
    "dataset:sanitizer:coverage": "node tools/llm-eval/report-sanitizer-coverage.js --cases adapters/auauratesting-gemma/eval-cases.jsonl --failures adapters/auauratesting-gemma/model-failures.jsonl --output adapters/auauratesting-gemma/data/sanitizer-coverage.md",
    "dataset:candidates": "node tools/llm-eval/extract-training-candidates.js --output adapters/auauratesting-gemma/data/training-candidates.jsonl --summary adapters/auauratesting-gemma/data/training-candidates-summary.json",
    "finetune:mlx:prepare": "node tools/llm-eval/export-mlx-sft.js --input adapters/auauratesting-gemma/data/auratest-gemma-sft.jsonl --output-dir adapters/auauratesting-gemma/finetune/mlx-data",
    "finetune:mlx:setup": "bash adapters/auauratesting-gemma/finetune/setup-mlx-venv.sh",
    "finetune:mlx:train:lowram": "bash adapters/auauratesting-gemma/finetune/train-lowram.sh",
    "eval:mlx:generate": "adapters/auauratesting-gemma/finetune/.venv/bin/python tools/llm-eval/run-mlx-eval.py --cases adapters/auauratesting-gemma/eval-cases.jsonl --system-file adapters/auauratesting-gemma/system-prompt.txt --adapter-path adapters/auauratesting-gemma/finetune/output/lowram-lora --output adapters/auauratesting-gemma/finetune/mlx-responses.jsonl",
    "eval:mlx:score": "node tools/llm-eval/run-eval.js --cases adapters/auauratesting-gemma/eval-cases.jsonl --responses adapters/auauratesting-gemma/finetune/mlx-responses.jsonl",
    "adapter:gemma:create": "ollama create auauratesting-gemma -f adapters/auauratesting-gemma/Modelfile",
    "adapter:gemma:install": "ollama pull gemma2:2b && npm run adapter:gemma:create"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "cors": "^2.8.5",
    "diff": "^5.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.1.0",
    "geoip-lite": "^2.0.3",
    "mysql2": "^3.10.0",
    "ollama": "^0.5.1",
    "pg": "^8.12.0",
    "playwright": "^1.60.0",
    "sqlite3": "^5.1.7",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.60.0",
    "babel-jest": "^30.4.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "tar": "^7.5.1",
    "fast-xml-parser": "^5.11.0",
    "brace-expansion": "^2.0.2",
    "ip-address": "^10.2.1",
    "uuid": "^11.1.0",
    "js-yaml": "^4.1.1",
    "shell-quote": "^1.8.5",
    "form-data": "^4.0.5"
  }
}
