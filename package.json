{
  "name": "auratest-ai",
  "version": "1.0.0",
  "description": "Local AI QA Agent",
  "main": "server.js",
  "type": "module",
  "bin": {
    "auraguard": "./bin/auraguard-cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev:server": "node --watch server.js",
    "frontend:install": "cd frontend && npm install",
    "frontend:dev": "cd frontend && npm run dev",
    "install:all": "npm install && npm run frontend:install",
    "setup": "npm run install:all && npx playwright install",
    "dev": "npx concurrently \"npm run dev:server\" \"npm run frontend:dev\"",
    "test": "jest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.12.1",
    "cors": "^2.8.5",
    "diff": "^5.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.1.0",
    "geoip-lite": "^2.0.3",
    "mysql2": "^3.10.0",
    "ollama": "^0.5.1",
    "pg": "^8.12.0",
    "sqlite3": "^5.1.7",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.60.0",
    "babel-jest": "^30.4.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "playwright": "^1.60.0",
    "supertest": "^7.2.2"
  }
}
