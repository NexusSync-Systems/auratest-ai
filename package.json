{
  "name": "auratest-ai",
  "version": "1.0.0",
  "description": "Local AI QA Agent",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "tsx server.ts",
    "dev:server": "tsx watch server.ts",
    "frontend:install": "cd frontend && npm install",
    "frontend:dev": "cd frontend && npm run dev",
    "install:all": "npm install && npm run frontend:install",
    "setup": "npm run install:all && npx playwright install",
    "dev": "npx concurrently \"npm run dev:server\" \"npm run frontend:dev\"",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "dataset:clean": "tsx scripts/clean-dataset.ts",
    "model:build": "tsx scripts/build-model.ts"
  },
  "dependencies": {
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "cors": "^2.8.5",
    "diff": "^5.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.10.0",
    "ollama": "^0.5.1",
    "pg": "^8.12.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.44.1",
    "pngjs": "^7.0.0",
    "sqlite3": "^5.1.7",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/cors": "^2.8.19",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^8.2.2",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
